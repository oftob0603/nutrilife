// Ma'lumot modeli. Jadvallar S1'dan boshlab qo'shiladi (PRD.md, 7-bo'lim).

generator client {
  provider            = "prisma-client"
  output              = "../lib/generated/prisma"
  moduleFormat        = "esm"
  // Ichki importlar .ts kengaytmasi bilan yoziladi — shunda klientni Node ham
  // to'g'ridan-to'g'ri o'qiy oladi (seed skripti uchun kerak).
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

/// Taom bazasi. Maydonlar prototipdagi FOODS tuzilmasidan olingan
/// (prototip/ui_kits/mobile-app/data.jsx): taom yo 100 grammga, yo bitta donaga
/// o'lchanadi, porsiya variantlari esa shu birlikda beriladi.
model Taom {
  id            String   @id
  /// O'zbekcha nom — interfeysda va jurnal yozuvida shu ko'rinadi.
  nomi          String
  nomiRu        String   @map("nomi_ru")
  nomiEn        String   @map("nomi_en")
  /// `public/` ichidagi rasm yo'li, masalan `/taomlar/osh.webp`; rasm yo'q bo'lsa bo'sh.
  rasm          String?
  olchovMiqdori Int      @map("olchov_miqdori")
  olchovBirligi String   @map("olchov_birligi")
  kaloriya      Float
  oqsil         Float
  yog           Float
  uglevod       Float
  porsiyalar    Int[]
  yaratilgan    DateTime @default(now())

  yozuvlar  OvqatYozuvi[]
  takliflar TaomTaklifi[]

  @@map("taomlar")
}

/// Taom takliflari navbati (PRD.md 7-bo'lim, admin-tz.md A4/A5, DECISIONS 2026-09-13): foydalanuvchi
/// E7'da AI natijasini tuzatib tasdiqlasa — AI aytgani va foydalanuvchi yozgani yonma-yon shu
/// yerga tushadi, admin ko'rib chiqadi. Umumiy `taomlar` bazasi faqat admin tasdig'i bilan
/// o'zgaradi. Hisob o'chsa qator qoladi, bog'lanishlar bo'shaydi; rasm esa hisob bilan ketadi
/// (`rasmlar` cascade) — shaxsiy ma'lumot navbatda qolmaydi.
model TaomTaklifi {
  id              String   @id @default(uuid())
  foydalanuvchiId String?  @map("foydalanuvchi_id")
  ovqatYozuviId   String?  @map("ovqat_yozuvi_id")
  rasmId          String?  @map("rasm_id")
  /// Tasdiqdan keyin: yangi yaratilgan yoki birlashtirilgan taom.
  taomId          String?  @map("taom_id")
  adminId         String?  @map("admin_id")

  /// AI natijasi (lib/services/skan-hisob.ts `SkanNatija`): 100 g uchun qiymatlar.
  aiTaomNomi      String   @map("ai_taom_nomi")
  aiPorsiyaGramm  Int      @map("ai_porsiya_gramm")
  aiKaloriya100   Float    @map("ai_kaloriya100")
  aiOqsil100      Float    @map("ai_oqsil100")
  aiYog100        Float    @map("ai_yog100")
  aiUglevod100    Float    @map("ai_uglevod100")

  /// Foydalanuvchi tasdiqlagan qiymatlar — kiritilgan porsiya uchun (yozuvdagi bilan bir xil).
  taomNomi        String   @map("taom_nomi")
  porsiyaGramm    Int      @map("porsiya_gramm")
  kaloriya        Float
  oqsil           Float
  yog             Float
  uglevod         Float
  /// Foydalanuvchi interfeysi tili — nom shu tilda yozilgan (A5 shu til maydonini oldindan to'ldiradi).
  til             String   @default("uz")

  /// "yangi", "korilmoqda", "tasdiqlandi", "rad_etildi" (lib/services/taom-taklif-hisob.ts).
  holat           String   @default("yangi")
  radSababi       String?  @map("rad_sababi")
  /// Admin qaror bergan vaqt.
  korilgan        DateTime?
  yaratilgan      DateTime @default(now())

  foydalanuvchi Foydalanuvchi? @relation("taomTakliflari", fields: [foydalanuvchiId], references: [id], onDelete: SetNull)
  ovqatYozuvi   OvqatYozuvi?   @relation(fields: [ovqatYozuviId], references: [id], onDelete: SetNull)
  rasm          Rasm?          @relation(fields: [rasmId], references: [id], onDelete: SetNull)
  taom          Taom?          @relation(fields: [taomId], references: [id], onDelete: SetNull)
  admin         Foydalanuvchi? @relation("taomTaklifQarorlari", fields: [adminId], references: [id], onDelete: SetNull)

  @@index([holat, yaratilgan])
  @@map("taom_takliflari")
}

/// Jurnalga tushgan har bir ovqat (PRD.md, 7-bo'lim). Taom nomi va raqamlari yozuv
/// ichiga ko'chiriladi — baza yozuvi keyin o'zgarsa ham jurnal o'sha kungi holatini
/// saqlaydi.
/// Jadvalga faqat tasdiqlangan yozuv tushadi — tasdiqlanmagan AI natijasi saqlanmaydi.
/// O'chirilgan yozuv qatori qoladi (`holat = "ochirildi"`) — streak va Score tarixi halol
/// qolsin; ekranlarda va kunlik jamida u ko'rinmaydi.
model OvqatYozuvi {
  id              String   @id @default(uuid())
  foydalanuvchiId String   @map("foydalanuvchi_id")
  taomId          String?  @map("taom_id")
  taomNomi        String   @map("taom_nomi")
  porsiya         String
  kaloriya        Float
  oqsil           Float
  yog             Float
  uglevod         Float
  ovqatTuri       String   @map("ovqat_turi")
  /// "qolda" yoki "ai".
  manba           String   @default("qolda")
  /// "tasdiqlandi", "tahrirlandi" yoki "ochirildi" (lib/services/yozuv-holati.ts).
  holat           String   @default("tasdiqlandi")
  vaqt            DateTime @default(now())

  foydalanuvchi Foydalanuvchi @relation(fields: [foydalanuvchiId], references: [id], onDelete: Cascade)
  taom         Taom?         @relation(fields: [taomId], references: [id], onDelete: SetNull)
  rasmlar       Rasm[]
  takliflar     TaomTaklifi[]

  @@index([foydalanuvchiId, vaqt])
  @@map("ovqat_yozuvlari")
}

/// Hisob egasi va butun ilovaga tegishli sozlamalar (PRD.md, 7-bo'lim;
/// onboarding-tz.md, 4-bo'lim). Hisob Telegram initData bilan birinchi kirishda yaratiladi.
model Foydalanuvchi {
  id            String    @id @default(uuid())
  telegramId    BigInt?   @unique @map("telegram_id")
  /// Telegram profil rasmi (initData `photo_url`); har kirishda yangilanadi. Rasm yashirilgan
  /// yoki yo'q bo'lsa bo'sh — ekranda ismning bosh harfi turadi.
  avatarUrl     String?   @map("avatar_url")
  til           String    @default("uz")
  /// "yorug", "qorongi" yoki "tizim".
  mavzu         String    @default("tizim")
  /// "kg" yoki "lb". Faqat ko'rsatish — bazada vazn doim kilogrammda.
  vaznBirligi   String    @default("kg") @map("vazn_birligi")
  /// "sm" yoki "ft". Faqat ko'rsatish — bazada bo'y doim santimetrda.
  boyBirligi    String    @default("sm") @map("boy_birligi")
  /// Telegram username (initData `username`), @siz; har kirishda yangilanadi. Admin paneli
  /// qidiruvi uchun (admin-tz.md A2) — foydalanuvchi uni yashirgan bo'lsa bo'sh.
  username      String?
  /// "foydalanuvchi" yoki "admin". FREE/PRO bu yerda emas — `obunalar` dan hisoblanadi
  /// (lib/services/huquqlar.ts).
  rol           String    @default("foydalanuvchi")
  /// Admin bloklagan sana va vaqt; bo'sh — bloklanmagan. Bloklash amali S6 8-taskda,
  /// A2 ro'yxatidagi "Bloklangan" filtri shu ustunga qaraydi.
  bloklangan    DateTime?
  /// Onboardingda "Boshlash" bosilgan sana va vaqt — Ommaviy oferta shu bilan qabul qilinadi.
  shartlarQabul DateTime? @map("shartlar_qabul")
  /// Qabul qilingan hujjat versiyasi (lib/shartlar.ts).
  shartlarVersiyasi String?   @map("shartlar_versiyasi")
  /// Onboardingda yosh qabul qilingan sana va vaqt — 18+ tasdig'i shu.
  tasdiq18plus  DateTime? @map("tasdiq_18plus")
  yaratilgan    DateTime  @default(now())

  profil          Profil?
  vaznYozuvlari   VaznYozuvi[]
  rejalar         Reja[]
  ovqatYozuvlari  OvqatYozuvi[]
  rasmlar         Rasm[]
  kunlikXulosalar KunlikXulosa[]
  skanHisoblari   SkanHisobi[]
  obunalar        Obuna[]
  hodisalar       Hodisa[]
  adminAmallari   AdminAmali[] @relation("adminAmallari")
  amallar         AdminAmali[] @relation("foydalanuvchiAmallari")
  taomTakliflari  TaomTaklifi[] @relation("taomTakliflari")
  taklifQarorlari TaomTaklifi[] @relation("taomTaklifQarorlari")

  @@map("foydalanuvchilar")
}

/// Onboarding javoblari. Savollar qadam-baqadam to'ldiriladi, shuning uchun
/// ustunlar bo'sh bo'lishi mumkin; `onboardingQadami` qayerda to'xtaganini saqlaydi.
/// Vazn bu yerda emas, `vazn_yozuvlari` da turadi.
model Profil {
  id                String   @id @default(uuid())
  foydalanuvchiId   String   @unique @map("foydalanuvchi_id")
  ism               String?
  jins              String?
  yosh              Int?
  /// Santimetrda saqlanadi, ko'rsatishda o'giriladi.
  boyi              Int?
  maqsad            String?
  faollik           String?
  ovqatAfzalliklari String[] @map("ovqat_afzalliklari")
  /// Kuniga necha mahal va asosan qayerda ovqatlanishi.
  ovqatlanishOdati  Json?    @map("ovqatlanish_odati")
  motivatsiya       String?
  onboardingQadami  Int      @default(0) @map("onboarding_qadami")
  /// Onboarding yakunlangan vaqt; bo'sh — hali tugamagan, Home ochilmaydi. Qadam raqamiga
  /// bog'lanmagan: oqimga keyin ekran qo'shilsa ham tugatganlar qayta o'tmaydi.
  onboardingTugadi  DateTime? @map("onboarding_tugadi")
  yangilangan       DateTime @updatedAt

  foydalanuvchi Foydalanuvchi @relation(fields: [foydalanuvchiId], references: [id], onDelete: Cascade)

  @@map("profillar")
}

/// Vazn o'lchovlari tarixi. Onboardingdagi joriy vazn birinchi yozuv bo'lib tushadi —
/// progress grafigi shu jadvaldan o'qiydi. Vazn kilogrammda saqlanadi.
model VaznYozuvi {
  id              String   @id @default(uuid())
  foydalanuvchiId String   @map("foydalanuvchi_id")
  vazn            Float
  /// Maqsad vazn; "Vaznni saqlash" tanlanganda bo'sh.
  maqsad          Float?
  vaqt            DateTime @default(now())

  foydalanuvchi Foydalanuvchi @relation(fields: [foydalanuvchiId], references: [id], onDelete: Cascade)

  @@index([foydalanuvchiId, vaqt])
  @@map("vazn_yozuvlari")
}

/// Hisoblangan kunlik norma — Home doirasining maxraji. Har qayta hisob yangi qator.
model Reja {
  id              String   @id @default(uuid())
  foydalanuvchiId String   @map("foydalanuvchi_id")
  kaloriya        Float
  oqsil           Float
  yog             Float
  uglevod         Float
  hisoblangan     DateTime @default(now())

  foydalanuvchi Foydalanuvchi @relation(fields: [foydalanuvchiId], references: [id], onDelete: Cascade)

  @@index([foydalanuvchiId, hisoblangan])
  @@map("rejalar")
}

/// Ovqat rasmlari. Rasm avval yuklanadi, yozuv esa tasdiqdan keyin yaratiladi —
/// shuning uchun `ovqatYozuviId` bo'sh bo'lishi mumkin. Hisob o'chsa qator ham o'chadi,
/// ombordagi faylni esa hisobni o'chirish servisi o'zi tozalashi kerak.
model Rasm {
  id              String   @id @default(uuid())
  foydalanuvchiId String   @map("foydalanuvchi_id")
  ovqatYozuviId   String?  @map("ovqat_yozuvi_id")
  /// Ombordagi (R2) obyekt kaliti.
  kalit           String   @unique
  mime            String
  hajm            Int
  yaratilgan      DateTime @default(now())

  foydalanuvchi Foydalanuvchi @relation(fields: [foydalanuvchiId], references: [id], onDelete: Cascade)
  ovqatYozuvi   OvqatYozuvi?  @relation(fields: [ovqatYozuviId], references: [id], onDelete: SetNull)
  takliflar     TaomTaklifi[]

  @@index([foydalanuvchiId])
  @@index([ovqatYozuviId])
  @@map("rasmlar")
}

/// Kunlik jami va Nutrition Score (S4).
model KunlikXulosa {
  id              String   @id @default(uuid())
  foydalanuvchiId String   @map("foydalanuvchi_id")
  sana            DateTime @db.Date
  kaloriya        Float
  oqsil           Float
  yog             Float
  uglevod         Float
  nutritionScore  Int?     @map("nutrition_score")

  foydalanuvchi Foydalanuvchi @relation(fields: [foydalanuvchiId], references: [id], onDelete: Cascade)

  @@unique([foydalanuvchiId, sana])
  @@map("kunlik_xulosa")
}

/// AI skan sarfi: har foydalanuvchining bir kundagi skanlari soni (PRD.md, 7-bo'lim).
/// FREE/PRO limitlari shu jadvalga tayanadi (lib/services/skan-hisobi.ts).
model SkanHisobi {
  id              String   @id @default(uuid())
  foydalanuvchiId String   @map("foydalanuvchi_id")
  /// Toshkent vaqti bo'yicha kun.
  sana            DateTime @db.Date
  /// Limitdan yeyilgan skanlar: AI taomni tanigan yoki hozir tahlil qilayotgan.
  soni            Int      @default(0)
  /// AI taomni taniy olmagan urinishlar — limitdan yeyilmaydi, lekin kunlik soni cheklangan.
  tanilmagan      Int      @default(0)

  foydalanuvchi Foydalanuvchi @relation(fields: [foydalanuvchiId], references: [id], onDelete: Cascade)

  @@unique([foydalanuvchiId, sana])
  @@map("skan_hisobi")
}

/// PRO obunalari (PRD.md, 7-bo'lim). Har to'lov yoki admin qo'lda bergan muddat — alohida
/// qator. PRO holati saqlanmaydi: `boshlanish <= hozir < tugash` bo'lgan qator bor bo'lsa
/// foydalanuvchi PRO. To'lov ustunlari S5'da to'lov bilan birga qo'shiladi.
model Obuna {
  id              String   @id @default(uuid())
  foydalanuvchiId String   @map("foydalanuvchi_id")
  /// "oylik", "yarim_yillik", "yillik" yoki "qolda" (tarifsiz muddat — admin uzaytirgan yoki
  /// boshqa muddat bergan).
  tarif           String
  /// "tolov" yoki "qolda" (admin paneldan bergan — daromad statistikasiga kirmaydi, admin-tz.md A3).
  manba           String   @default("tolov")
  boshlanish      DateTime @default(now())
  tugash          DateTime
  /// Bot orqali yuborilgan oxirgi muddat xabari bosqichi (lib/services/obuna-xabar-hisob.ts):
  /// 0 — hali yo'q, 1 — 7 kun, 2 — 3 kun, 3 — 1 kun, 4 — tugadi, 5 — qayta taklif.
  xabarBosqichi   Int      @default(0) @map("xabar_bosqichi")
  yaratilgan      DateTime @default(now())

  foydalanuvchi Foydalanuvchi @relation(fields: [foydalanuvchiId], references: [id], onDelete: Cascade)

  @@index([foydalanuvchiId, tugash])
  @@map("obunalar")
}

/// Analitika hodisalari (lib/services/hodisalar.ts): "royxat", "onboarding_tugadi",
/// "birinchi_skan" — hisobga bir marta, "kunlik_faollik" — kuniga bitta qator. Hisob o'chsa
/// qator qoladi, faqat egasi bo'shaydi — sonlar yo'qolmaydi, shaxs bilan bog'lanish uziladi.
model Hodisa {
  id              String   @id @default(uuid())
  foydalanuvchiId String?  @map("foydalanuvchi_id")
  tur             String
  /// Toshkent vaqti bo'yicha kun.
  sana            DateTime @db.Date
  vaqt            DateTime @default(now())

  foydalanuvchi Foydalanuvchi? @relation(fields: [foydalanuvchiId], references: [id], onDelete: SetNull)

  @@unique([foydalanuvchiId, tur, sana])
  @@index([tur, sana])
  @@map("hodisalar")
}

/// Admin amallari jurnali (admin-tz.md §1, §4): ma'lumotni o'zgartiradigan har amal — kim, kimga,
/// nima, sabab. Tahrirlanmaydi va o'chirilmaydi. Admin yoki foydalanuvchi hisobi o'chsa qator
/// qoladi, bog'lanish bo'shaydi.
model AdminAmali {
  id              String   @id @default(uuid())
  adminId         String?  @map("admin_id")
  foydalanuvchiId String?  @map("foydalanuvchi_id")
  /// "pro_berish", "muddat_uzaytirish", "pro_olish"; keyingi tasklar o'z turlarini qo'shadi.
  tur             String
  /// Jadvalda ko'rinadigan qisqa izoh: "Yillik, 2027-10-06 gacha".
  tafsilot        String
  sabab           String
  eski            Json?
  yangi           Json?
  vaqt            DateTime @default(now())

  admin         Foydalanuvchi? @relation("adminAmallari", fields: [adminId], references: [id], onDelete: SetNull)
  foydalanuvchi Foydalanuvchi? @relation("foydalanuvchiAmallari", fields: [foydalanuvchiId], references: [id], onDelete: SetNull)

  @@index([vaqt])
  @@index([foydalanuvchiId, vaqt])
  @@map("admin_amallari")
}
