// Ma'lumot modeli. Jadvallar S1'dan boshlab qo'shiladi (PRD.md, 7-bo'lim).

generator client {
  provider            = "prisma-client"
  output              = "../lib/generated/prisma"
  moduleFormat        = "esm"
  // Ichki importlar .ts kengaytmasi bilan yoziladi — shunda klientni Node ham
  // to'g'ridan-to'g'ri o'qiy oladi (seed skripti uchun kerak).
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

/// Taom bazasi. Maydonlar prototipdagi FOODS tuzilmasidan olingan
/// (prototip/ui_kits/mobile-app/data.jsx): taom yo 100 grammga, yo bitta donaga
/// o'lchanadi, porsiya variantlari esa shu birlikda beriladi.
model Taom {
  id            String   @id
  nomi          String
  olchovMiqdori Int      @map("olchov_miqdori")
  olchovBirligi String   @map("olchov_birligi")
  kaloriya      Float
  oqsil         Float
  yog           Float
  uglevod       Float
  porsiyalar    Int[]
  yaratilgan    DateTime @default(now())

  yozuvlar OvqatYozuvi[]

  @@map("taomlar")
}

/// Jurnalga tushgan har bir ovqat (PRD.md, 7-bo'lim). Taom nomi va raqamlari yozuv
/// ichiga ko'chiriladi — baza yozuvi keyin o'zgarsa ham jurnal o'sha kungi holatini
/// saqlaydi. S1'da foydalanuvchi tizimi yo'q, shuning uchun `foydalanuvchiId`
/// qotirilgan sinov qiymatini oladi va S3'da real ID ga almashadi.
model OvqatYozuvi {
  id              String   @id @default(uuid())
  foydalanuvchiId String   @map("foydalanuvchi_id")
  taomId          String?  @map("taom_id")
  taomNomi        String   @map("taom_nomi")
  porsiya         String
  kaloriya        Float
  oqsil           Float
  yog             Float
  uglevod         Float
  ovqatTuri       String   @map("ovqat_turi")
  vaqt            DateTime @default(now())

  taom Taom? @relation(fields: [taomId], references: [id], onDelete: SetNull)

  @@index([foydalanuvchiId, vaqt])
  @@map("ovqat_yozuvlari")
}
