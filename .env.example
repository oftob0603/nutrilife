# Nusxa oling: cp .env.example .env — haqiqiy qiymatlar faqat .env'da.
# Production'da bu qiymatlar Railway/Vercel Environment Variables orqali beriladi.

# Railway PostgreSQL connection string.
# Lokal ishlash uchun Railway'dagi public (proxy) manzil olinadi;
# *.railway.internal manzili faqat Railway ichida ishlaydi.
DATABASE_URL=""

# Ilova manzili: lokalda http://localhost:3000, production'da mahsulot domeni.
APP_URL="http://localhost:3000"

# Uzun tasodifiy sessiya siri. Yaratish:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""
