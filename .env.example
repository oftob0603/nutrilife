# Nusxa oling: cp .env.example .env — haqiqiy qiymatlar faqat .env'da.
# Production'da bu qiymatlar Railway/Vercel Environment Variables orqali beriladi.

# Railway PostgreSQL connection string.
# Lokal ishlash uchun Railway'dagi public (proxy) manzil olinadi;
# *.railway.internal manzili faqat Railway ichida ishlaydi.
DATABASE_URL=""

# Ilova manzili: lokalda http://localhost:3000, production'da mahsulot domeni.
APP_URL="http://localhost:3000"

# AI skan (POST /api/skan). Hozircha Claude API kaliti; model almashtirilsa kod o'zgarmaydi.
# Production'da Vercel Environment Variables'ga qo'shiladi va yangi deploy'da kuchga kiradi.
AI_API_KEY=""
AI_MODEL="claude-haiku-4-5"
# Bir kundagi AI skanlar chegarasi (Toshkent vaqti bo'yicha). Berilmasa — 50.
SKAN_KUNLIK_CHEGARA="50"

# Telegram bot tokeni (@BotFather) — Mini App initData imzosi shu bilan tekshiriladi
# (POST /api/auth/telegram). Production'da Vercel Environment Variables'da.
TELEGRAM_BOT_TOKEN=""

# Uzun tasodifiy sessiya siri. Yaratish:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""
